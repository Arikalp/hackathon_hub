rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // User avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Team logos and assets
    match /teams/{teamId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Hackathon banners & project submissions
    match /hackathons/{hackathonId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public general read
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
